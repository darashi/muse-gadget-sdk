# M5Stack Tab5: ESP32-P4 (pre-v3 silicon), 16 MB flash, 32 MB PSRAM.
# 720x1280 MIPI-DSI LCD and touch, ES8388 speaker and ES7210 microphones.
# Pins: M5Stack M5Tab5-UserDemo/platforms/tab5/sdkconfig and Espressif's
# m5stack_tab5 BSP 1.3.2. USB-C uses native USB Serial/JTAG (303a:1001).
# Load after sdkconfig.defaults and devices/sdkconfig.muse.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_MUSE_BOARD_M5STACK_TAB5=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_MUSE_CONSOLE_UART=n
CONFIG_LV_COLOR_DEPTH=16
# Two 46 KB draw buffers in PSRAM, plus the BSP's DSI scanout buffer.
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=32
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=1
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=n
# RESET/BOOT is not a user GPIO. Pairing and PTT use the touchscreen.
CONFIG_HOMEHUB_BUTTON_GPIO=0
# C6 SDIO wiring from the factory firmware: CLK12, CMD13, D0..D3=11,10,9,8.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
# NimBLE on P4 uses the C6's BLE controller through ESP-Hosted VHCI.
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
